@{
    ViewData["Title"] = "รายงานแสดงผลการส่ง API ให้กับระบบ TBR";
}
<div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-2">
    <h1 class="mb-0">รายงานแสดงผลการส่ง API ให้กับระบบ TBR</h1>
    <span class="factory-total"><span id="recordCount">—</span> รายการ</span>
</div>
<div id="alertMessage" class="alert alert-danger d-none" role="alert"></div>
<div class="card">
    <div class="search-toolbar flex-wrap">
        <label for="dateFrom">วันที่ส่ง</label><input id="dateFrom" type="date" class="form-control" style="width:auto" />
        <label for="dateTo">ถึง</label><input id="dateTo" type="date" class="form-control" style="width:auto" />
        <button id="btnSearch" type="button" class="btn btn-outline-primary">ค้นหา</button>
        <button id="btnAdvanced" type="button" class="btn btn-outline-secondary" aria-expanded="false" aria-controls="advancedFields">ค้นหาขั้นสูง</button>
        <button id="btnExport" type="button" class="export-button" disabled title="ส่งออกผลค้นหาทั้งหมด">↓ ส่งออก Excel (ผลค้นหาทั้งหมด)</button>
    </div>
    <div id="advancedFields" class="row g-3 p-3 border-top d-none">
        <div class="col-md-4"><label for="apiEndPoint" class="form-label">API Name</label><input id="apiEndPoint" class="form-control" /></div>
        <div class="col-md-4"><label for="requestRefKey" class="form-label">BJC REFID</label><input id="requestRefKey" class="form-control" /></div>
        <div class="col-md-4"><label for="responseRefKey" class="form-label">TBR REFID</label><input id="responseRefKey" class="form-control" /></div>
        <div class="col-md-6"><label for="requestBody" class="form-label">Request Body</label><input id="requestBody" class="form-control" /></div>
        <div class="col-md-6"><label for="responseStatus" class="form-label">Response Status</label><input id="responseStatus" class="form-control" /></div>
        <div class="col-12"><button id="btnAdvancedSearch" type="button" class="btn btn-primary">ค้นหาขั้นสูง</button></div>
    </div>
    <div class="table-responsive">
        <table id="apiLogTable" class="table table-hover factory-table mb-0" aria-label="รายงานแสดงผลการส่ง API ให้กับระบบ TBR">
            <thead><tr><th>วันที่ส่ง</th><th>API Name</th><th>Response Status</th><th>Response Code</th><th>Message</th><th>Res RefID</th><th>Req RefID</th><th>จัดการ</th></tr></thead>
            <tbody><tr><td colspan="8" class="text-center text-muted py-4">กำลังโหลดข้อมูล...</td></tr></tbody>
        </table>
    </div>
    <div class="table-footer">
        <div id="paginationSummary" aria-live="polite"></div>
        <div class="pagination-controls"><label for="pageSize">แสดง</label><partial name="_PageSizeSelector" /><span>ต่อหน้า</span><nav aria-label="หน้ารายงาน"><ul id="pagination" class="pagination mb-0"></ul></nav></div>
    </div>
</div>
<div class="modal fade" id="bodyModal" tabindex="-1" aria-labelledby="bodyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 id="bodyModalTitle" class="modal-title fs-5"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div>
        <div class="modal-body"><pre id="bodyModalContent" class="mb-0 p-3 bg-light border rounded text-break" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button></div>
    </div></div>
</div>
@section Scripts {
<script src="~/js/excel-export.js" asp-append-version="true"></script>
<script>
(() => {
    let currentPage = 1, advanced = false, activeRequest = null, visibleRows = [], totalCount = 0;
    const bodyModal = new bootstrap.Modal(document.getElementById('bodyModal'));
    const escapeHtml = value => $('<div>').text(value ?? '').html();
    const formatDate = value => value ? new Date(value).toLocaleString(document.documentElement.lang === 'en' ? 'en-GB' : 'th-TH') : '';
    function bodyContent(row, isRequest) {
        const raw = isRequest ? row.requestBody : row.responseData;
        if (raw == null || !String(raw).trim()) return null;
        try {
            const parsed = JSON.parse(raw);
            return JSON.stringify(isRequest ? parsed : {
                Status: row.responseStatus,
                StatusCode: row.responseCode,
                Message: row.responseMessage,
                Data: parsed
            }, null, 2);
        } catch { return String(raw); }
    }
    const filters = (page, perPage) => ({
        dateFrom: $('#dateFrom').val(), dateTo: $('#dateTo').val(), advanced,
        apiEndPoint: $('#apiEndPoint').val(), requestRefKey: $('#requestRefKey').val(),
        responseRefKey: $('#responseRefKey').val(), requestBody: $('#requestBody').val(),
        responseStatus: $('#responseStatus').val(), page, perPage
    });
    function loadRows(page = 1) {
        if (activeRequest) activeRequest.abort();
        $('#alertMessage').addClass('d-none');
        $('#btnSearch, #btnAdvancedSearch, #btnExport').prop('disabled', true);
        activeRequest = $.getJSON('@Url.Action("Search", "ApiLogReport")', filters(page, Number($('#pageSize').val()))).done(response => {
            const rows = response.rows, p = response.pagination;
            visibleRows = rows;
            totalCount = p.totalCount;
            currentPage = p.page;
            $('#recordCount').text(p.totalCount.toLocaleString());
            $('#btnExport').prop('disabled', !totalCount);
            $('#apiLogTable tbody').html(rows.length ? rows.map((row, index) => `<tr>
                <td>${escapeHtml(formatDate(row.requestDate))}</td><td>${escapeHtml(row.apiEndPoint)}</td>
                <td>${escapeHtml(row.responseStatus)}</td><td>${escapeHtml(row.responseCode)}</td>
                <td>${escapeHtml(row.responseMessage)}</td><td>${escapeHtml(row.responseRefKey)}</td>
                <td>${escapeHtml(row.requestRefKey)}</td><td><div class="row-actions flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary btn-body" data-index="${index}" data-kind="request">Request Body</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-body" data-index="${index}" data-kind="response">Response Body</button>
                </div></td>
            </tr>`).join('') : '<tr><td colspan="8" class="text-center text-muted py-4">ไม่พบข้อมูล</td></tr>');
            const first = p.totalCount ? (p.page - 1) * p.perPage + 1 : 0;
            $('#paginationSummary').text(`${first}–${Math.min(p.page * p.perPage, p.totalCount)} จาก ${p.totalCount} รายการ`);
            $('#pagination').html(`<li class="page-item ${p.page <= 1 ? 'disabled' : ''}"><button class="page-link" type="button" data-page="${p.page - 1}" ${p.page <= 1 ? 'disabled' : ''}>‹</button></li><li class="page-position">${p.page} / ${p.totalPages}</li><li class="page-item ${p.page >= p.totalPages ? 'disabled' : ''}"><button class="page-link" type="button" data-page="${p.page + 1}" ${p.page >= p.totalPages ? 'disabled' : ''}>›</button></li>`);
        }).fail(xhr => {
            if (xhr.statusText === 'abort') return;
            visibleRows = [];
            totalCount = 0;
            $('#btnExport').prop('disabled', true);
            $('#apiLogTable tbody').html('<tr><td colspan="8" class="text-center text-muted py-4">โหลดข้อมูลไม่สำเร็จ</td></tr>');
            $('#alertMessage').removeClass('d-none').text(xhr.responseJSON?.message || 'ไม่สามารถโหลดข้อมูลได้ กรุณาลองใหม่');
        }).always(() => $('#btnSearch, #btnAdvancedSearch').prop('disabled', false));
    }
    $('#btnSearch').on('click', () => { advanced = false; loadRows(1); });
    $('#btnAdvanced').on('click', function () {
        const shown = $('#advancedFields').toggleClass('d-none').hasClass('d-none') === false;
        $(this).attr('aria-expanded', shown);
    });
    $('#btnAdvancedSearch').on('click', () => { advanced = true; loadRows(1); });
    $('#btnExport').on('click', async function () {
        if (!totalCount) return;
        const button = $(this).prop('disabled', true);
        const search = filters(1, 100);
        const rows = [];
        try {
            for (let page = 1; ; page++) {
                const response = await $.getJSON('@Url.Action("Search", "ApiLogReport")', { ...search, page });
                rows.push(...response.rows);
                if (page >= response.pagination.totalPages) break;
            }
            const english = document.documentElement.lang === 'en';
            const columns = [
                ['requestDate', english ? 'Sent Date' : 'วันที่ส่ง'], ['apiEndPoint', 'API Name'],
                ['responseStatus', 'Response Status'], ['responseCode', 'Response Code'],
                ['responseMessage', 'Message'], ['responseRefKey', 'Res RefID'], ['requestRefKey', 'Req RefID'],
                ['requestBody', 'Request Body'], ['responseBody', 'Response Body']
            ];
            ExcelExport.download(columns.map(column => column[1]), rows.map(row => Object.fromEntries(
                columns.map(([key, header]) => [header,
                    key === 'requestDate' ? formatDate(row[key])
                    : key === 'requestBody' ? bodyContent(row, true) ?? ''
                    : key === 'responseBody' ? bodyContent(row, false) ?? '' : row[key]])
            )), 'api-log-report.xlsx');
        } catch {
            $('#alertMessage').removeClass('d-none').text('ไม่สามารถส่งออก Excel ได้ กรุณาลองใหม่');
        } finally { button.prop('disabled', !totalCount); }
    });
    $('#advancedFields input, #dateFrom, #dateTo').on('keydown', event => { if (event.key === 'Enter') { advanced = !$('#advancedFields').hasClass('d-none'); loadRows(1); } });
    $('#pageSize').on('change', () => loadRows(1));
    $('#pagination').on('click', '.page-link:not(:disabled)', function () { loadRows(Number($(this).data('page'))); });
    $('#apiLogTable').on('click', '.btn-body', function () {
        const row = visibleRows[Number($(this).data('index'))];
        if (!row) return;
        const isRequest = $(this).data('kind') === 'request';
        $('#bodyModalTitle').text(isRequest ? 'Request Body' : 'Response Body');
        $('#bodyModalContent').text(bodyContent(row, isRequest) ?? 'ไม่มีข้อมูล');
        bodyModal.show();
    });
    loadRows();
})();
</script>
}
