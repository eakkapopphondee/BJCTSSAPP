@{
    ViewData["Title"] = "ข้อมูลโรงงาน";
}
<div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div class="d-flex align-items-center gap-2"><h1 class="mb-0">ข้อมูลโรงงาน</h1><span class="factory-total"><span id="factoryCount" aria-live="polite">—</span> รายการ</span></div>
    <a class="btn btn-primary btn-add" href="@Url.Action("Create", "Factory")">＋ เพิ่มโรงงาน</a>
</div>
@Html.AntiForgeryToken()
<div id="alertMessage" class="alert d-none" role="alert"></div>
<span id="connectionStatus" class="visually-hidden" role="status">กำลังเชื่อมต่อฐานข้อมูล...</span>
<div class="card">
    <div class="search-toolbar">
        <div class="search-field"><label for="searchBox" class="visually-hidden">ค้นหาโรงงาน</label><span class="search-symbol" aria-hidden="true">⌕</span><input id="searchBox" type="search" class="form-control" placeholder="ค้นหารหัสบริษัท ชื่อบริษัท รหัสสาขา ชื่อสาขา รหัส SAP หรือชื่อสาขาใน SAP" /></div>
        <label for="dataStatusFilter" class="visually-hidden">สถานะ</label>
        <select id="dataStatusFilter" class="form-select status-filter"><option value="L">ทั้งหมด</option><option value="A" selected>ใช้งานอยู่</option><option value="C">ยกเลิก</option></select>
        <button id="btnSearch" type="button" class="btn btn-outline-primary">ค้นหา</button>
        <button id="btnExport" type="button" class="export-button" disabled title="ส่งออกผลค้นหาทั้งหมด">↓ ส่งออก Excel (ผลค้นหาทั้งหมด)</button>
    </div>
    <div class="table-responsive">
        <table id="factoryTable" class="table table-hover factory-table mb-0" aria-label="รายการโรงงาน">
            <thead><tr><th>ภาพโลโก้</th><th>รหัส / ชื่อโรงงาน</th><th>ที่อยู่ / ติดต่อ</th><th>ข้อมูล SAP</th><th>ประเภทโปรแกรม</th><th>สำเนาบัตรชั่ง</th><th>สถานะ</th><th>จัดการ</th></tr></thead>
            <tbody><tr><td colspan="8" class="text-center text-muted py-4">กำลังโหลดข้อมูล...</td></tr></tbody>
        </table>
    </div>
    <div class="table-footer">
        <div id="paginationSummary" aria-live="polite"></div>
        <div class="pagination-controls"><label for="pageSize">แสดง</label><partial name="_PageSizeSelector" /><span>ต่อหน้า</span><nav aria-label="หน้ารายการโรงงาน"><ul id="pagination" class="pagination mb-0"></ul></nav></div>
    </div>
</div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 id="deleteModalLabel" class="modal-title fs-5">ยืนยันการลบโรงงาน</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div>
        <div class="modal-body">ต้องการลบข้อมูลโรงงาน <strong id="deleteId"></strong> หรือไม่? การลบนี้จะนำข้อมูลออกจากระบบถาวร</div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ย้อนกลับ</button><button id="btnConfirmDelete" type="button" class="btn btn-danger">ลบโรงงาน</button></div>
    </div></div>
</div>

@section Scripts {
<script src="~/js/setup-api.js" asp-append-version="true"></script>
<script src="~/js/excel-export.js" asp-append-version="true"></script>
<script>
(() => {
    let currentPage = 1, deleteId = null, visibleRows = [], activeRequest = null;
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    const token = $('input[name="__RequestVerificationToken"]').val();
    const display = value => $('<div>').text(value ?? '').html();
    function message(text, type = 'danger') {
        $('#alertMessage').removeClass('d-none alert-danger alert-success').addClass(`alert-${type}`).text(text);
    }
    function loadRows(page = currentPage) {
        if (activeRequest) activeRequest.abort();
        $('#btnSearch, #btnExport').prop('disabled', true);
        $('#alertMessage').addClass('d-none');
        $('#connectionStatus').text('กำลังโหลดข้อมูล...');
        activeRequest = $.getJSON('@Url.Content("~/v1/Setup/Factory/Search")', {
            TextSearch: $('#searchBox').val(), DataStatus: $('#dataStatusFilter').val(), Page: page, PerPage: Number($('#pageSize').val())
        }).done(response => {
            currentPage = response.Pagination.Page;
            visibleRows = SetupApi.rows(response);
            $('#factoryCount').text(response.Pagination.TotalCount.toLocaleString('th-TH'));
            $('#connectionStatus').text('เชื่อมต่อฐานข้อมูลแล้ว');
            $('#btnExport').prop('disabled', !visibleRows.length);
            renderRows(visibleRows);
            renderPagination({ page: currentPage, pageSize: response.Pagination.PerPage, totalCount: response.Pagination.TotalCount, totalPages: response.Pagination.TotalPages });
        }).fail(xhr => {
            if (xhr.statusText === 'abort') return;
            visibleRows = [];
            $('#factoryCount').text('—');
            $('#connectionStatus').text('โหลดข้อมูลไม่สำเร็จ');
            $('#factoryTable tbody').html('<tr><td colspan="8" class="text-center text-muted py-4">โหลดข้อมูลไม่สำเร็จ กรุณากดค้นหาเพื่อลองใหม่</td></tr>');
            $('#pagination, #paginationSummary').empty();
            message(xhr.responseJSON?.Message || 'ไม่สามารถโหลดข้อมูลโรงงานได้ กรุณาลองใหม่');
        }).always(() => $('#btnSearch').prop('disabled', false));
    }
    function renderRows(rows) {
        if (!rows.length) {
            $('#factoryTable tbody').html('<tr><td colspan="8" class="text-center text-muted py-4">ไม่พบข้อมูลโรงงาน</td></tr>');
            return;
        }
        $('#factoryTable tbody').html(rows.map(row => `<tr>
            <td class="logo-cell"></td><td><div class="factory-code">${display(row.factoryCode)}</div><div class="cell-title">${display(row.factoryDesc)}</div></td>
            <td><div class="cell-title">${display(row.address1)}</div><div class="cell-detail">${display(row.address2)} ${display(row.address3)}</div><div class="cell-detail">${display(row.branchCode)} / ${display(row.branchDesc)}</div><div class="cell-detail">${display(row.phoneNumber)}</div></td>
            <td>${display(row.sapCode)}<div class="cell-detail">${display(row.sapDesc)}</div></td>
            <td><span class="program-badge">${display(row.programTypeCode ?? row.programTypeID)}</span><div class="cell-detail">${display(row.programTypeName)}</div></td>
            <td>${row.printFlag === 'Y' ? `${display(row.printCopy)} สำเนา` : 'ไม่พิมพ์'}</td>
            <td><span class="status-badge ${row.dataStatus === 'C' ? 'cancelled' : ''}">${row.dataStatus === 'A' ? 'ใช้งานอยู่' : row.dataStatus === 'C' ? 'ยกเลิก' : display(row.dataStatus)}</span></td>
            <td><div class="row-actions"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", "Factory")/${encodeURIComponent(row.id)}"><svg class="action-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m16 3 5 5L8 21H3v-5L16 3Z"/><path d="m14 5 5 5"/></svg><span>แก้ไข</span></a><button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${Number(row.id)}"><svg class="action-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></svg><span>ลบ</span></button></div></td>
        </tr>`).join(''));
        $('#factoryTable tbody tr').each(function (index) {
            const path = rows[index].logoPath;
            const fallback = '@Url.Content("~/images/factory-default.svg")';
            const src = path ? '@Url.Content("~/")' + path.replace(/^\/+/, '') : fallback;
            $('<img>', { src, alt: 'Logo ' + rows[index].factoryDesc, width: 56, height: 56 })
                .css('object-fit', 'contain')
                .one('error', function () { this.src = fallback; })
                .appendTo($(this).find('.logo-cell'));
        });
    }
    function renderPagination({ page, totalPages, totalCount, pageSize }) {
        const first = totalCount ? (page - 1) * pageSize + 1 : 0;
        $('#paginationSummary').text(`${first}–${Math.min(page * pageSize, totalCount)} จาก ${totalCount} รายการ`);
        $('#pagination').html(`<li class="page-item ${page <= 1 ? 'disabled' : ''}"><button class="page-link" type="button" data-page="${page - 1}" aria-label="หน้าก่อนหน้า" ${page <= 1 ? 'disabled' : ''}>‹</button></li><li class="page-position">${page} / ${totalPages}</li><li class="page-item ${page >= totalPages ? 'disabled' : ''}"><button class="page-link" type="button" data-page="${page + 1}" aria-label="หน้าถัดไป" ${page >= totalPages ? 'disabled' : ''}>›</button></li>`);
    }
    $('#btnExport').on('click', () => {
        const fields = ['factoryCode', 'factoryDesc', 'address1', 'address2', 'address3', 'branchCode', 'branchDesc', 'phoneNumber', 'sapCode', 'sapDesc', 'programTypeID', 'programTypeCode', 'programTypeName', 'printFlag', 'printCopy', 'dataStatus'];
        const button = $("#btnExport").prop("disabled", true);
        ExcelExport.downloadSearch(fields, '@Url.Content("~/v1/Setup/Factory/Search")', { TextSearch: $('#searchBox').val(), DataStatus: $('#dataStatusFilter').val() }, `factories.xlsx`)
            .catch(() => message("ไม่สามารถส่งออก Excel ได้ กรุณาลองใหม่"))
            .finally(() => button.prop("disabled", false));
    });
    $('#btnSearch').on('click', () => loadRows(1));
    $('#searchBox').on('keydown', event => { if (event.key === 'Enter') loadRows(1); });
    $('#dataStatusFilter, #pageSize').on('change', () => loadRows(1));
    $('#pagination').on('click', '.page-link:not(:disabled)', function () { loadRows(Number($(this).data('page'))); });
    $('#factoryTable').on('click', '.btn-delete', function () {
        deleteId = $(this).data('id'); $('#deleteId').text(deleteId); modal.show();
    });
    $('#btnConfirmDelete').on('click', function () {
        if (deleteId === null) return;
        const button = $(this).prop('disabled', true);
        $.ajax({ url: '@Url.Content("~/v1/Setup/Factory/Delete")', method: 'DELETE', contentType: 'application/json', data: JSON.stringify({ ID: Number(deleteId) }), headers: { 'RequestVerificationToken': token } })
            .done(() => { modal.hide(); loadRows(); })
            .fail(xhr => { modal.hide(); message(xhr.responseJSON?.Message || 'ไม่สามารถลบข้อมูลได้ กรุณาลองใหม่'); })
            .always(() => button.prop('disabled', false));
    });
    loadRows();
})();
</script>
}

