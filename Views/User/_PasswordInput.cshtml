@model string

<div class="input-group">
    <input id="@Model" name="@Model" type="password" autocomplete="new-password" class="form-control" required />
    <button type="button" class="btn btn-outline-secondary" data-password-toggle="@Model" aria-controls="@Model" aria-pressed="false">แสดงรหัสผ่าน</button>
</div>
